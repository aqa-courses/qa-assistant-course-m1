# Claude: https://platform.claude.com/settings/keys (the API needs a funded balance, there is no free tier)
ANTHROPIC_API_KEY=
# Model for all agents; per agent, e.g. a stronger one for a judge: AGENT_MODEL_TRIAGE_JUDGE=claude-sonnet-5-5
AGENT_MODEL=claude-haiku-5-5

# Another provider instead of Claude: the model name picks it (assistant/shared/providers.py).
#   AGENT_MODEL=gemini-3.5-flash-lite      GOOGLE_API_KEY
#   AGENT_MODEL=deepseek/deepseek-flash    DEEPSEEK_API_KEY
#   AGENT_MODEL=ollama/qwen3:4b            a local Ollama, no key; OLLAMA_BASE_URL if it is not on localhost
#   AGENT_MODEL=ollama/deepseek-v4.1-flash a model hosted by Ollama Cloud: OLLAMA_BASE_URL=https://ollama.com/v1 and OLLAMA_API_KEY
#   AGENT_MODEL=openai/<model>             any OpenAI-compatible server: OPENAI_BASE_URL and OPENAI_API_KEY
GOOGLE_API_KEY=
DEEPSEEK_API_KEY=
OLLAMA_BASE_URL=
OLLAMA_API_KEY=
OPENAI_BASE_URL=
OPENAI_API_KEY=

# Your fork of this repository and a fine-grained token with access to the fork only (README: "Форк и токен GitHub").
# Module 1: Actions + Contents, read. Modules 2-3 add Issues read/write; modules 4-8 add Contents and Pull requests read/write.
GITHUB_REPO=owner/qa-assistant-course
GITHUB_TOKEN=

# Guard rails
SESSION_TOKEN_BUDGET=1500000
MAX_TOOL_RESPONSE_CHARS=20000
