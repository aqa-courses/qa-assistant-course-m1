# Gemini: https://aistudio.google.com/apikey
GOOGLE_API_KEY=
# Model for all agents; per agent: AGENT_MODEL_GITHUB_AGENT=...
AGENT_MODEL=gemini-3.5-flash

# Your fork of this repository and a token that can read its Actions (fine-grained: Actions + Contents, read-only)
GITHUB_REPO=owner/qa-assistant-course
GITHUB_TOKEN=

# Guard rails
SESSION_TOKEN_BUDGET=200000
MAX_TOOL_RESPONSE_CHARS=20000
